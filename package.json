{
  "name": "dino-ovum",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "start": "pnpm --filter @dino-ovum/website start",
    "build": "pnpm --filter @dino-ovum/website build",
    "serve": "pnpm --filter @dino-ovum/website serve",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . && stylelint \"packages/theme/src/**/*.{css,scss}\" \"website/src/**/*.css\"",
    "format": "prettier --write \"*.{js,json}\" \"packages/**/*.{js,jsx,json,css,scss}\" \"tests/**/*.js\" \"scripts/**/*.js\" \".github/scripts/**/*.js\" \"website/*.{js,json}\"",
    "pack:packages": "node scripts/pack.js",
    "verify:packages": "node scripts/verify.js",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "description": "Shared Docusaurus presets and themes for dino-nest."
}
